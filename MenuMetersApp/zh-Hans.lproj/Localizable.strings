" (%@ hyperthreads per core)" = "（每核心 %1$@ 个超线程）";
"%@%@ physical cores" = "%1$@ 个物理核心%2$@";

// Load average title
"Load Average (1m, 5m, 15m):" = "平均载入(1m, 5m, 15m)：";

// Load average format
